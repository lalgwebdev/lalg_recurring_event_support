/*
 * hook_entity_bundle_field_info
 */
function lalg_recurring_event_support_entity_bundle_field_info(EntityTypeInterface $entity_type, $bundle, array $base_field_definitions) {
    $fields = [];
    if ($entity_type->id() == 'eventseries' && $bundle == 'lalg_event' && !empty($base_field_definitions['title'])) {
        $field = BaseFieldOverride::createFromBaseFieldDefinition($base_field_definitions['title'], $bundle);
        $field->setLabel(t('Admin Title'))
            ->setDescription(t('The administrative title for reference by admins.'));
        $fields['title'] = $field;
    }
    return $fields;
}

/*
 * hook_menu_local_tasks_alter
 */
function lalg_recurring_event_support_menu_local_tasks_alter(&$data, $route_name, Drupal\Core\Cache\CacheableMetadata $cacheability) {
    if(!str_contains($route_name, 'entity.eventseries')) {
        return;
    }
    // Remove Add Instance tab.
    unset($data['tabs'][0]['entity.eventseries.add_instance_form']);
    
    $eventseries = \Drupal::routeMatch()->getParameter('eventseries');
    if (!$eventseries) {
        return;
    }

    $relationships = GroupRelationship::loadByEntity($eventseries);
    $group_id = $relationships ? reset($relationships)->getGroup()->id() : NULL;
    if ($group_id === NULL) {
        return;
    }

    // Change the Clone tab's destination for Event Series with a group.
    if (isset($data['tabs'][0]['eventseries.clone_form'])) {
        $data['tabs'][0]['eventseries.clone_form']['#link']['url'] = Url::fromRoute(
            'lalg.eventseries.clone',
                [
                    'group' => $group_id,
                    'eventseries' => $eventseries->id(),
                ],
        );
        $cacheability->addCacheableDependency($eventseries);
        $cacheability->addCacheableDependency($group);
    }
}
