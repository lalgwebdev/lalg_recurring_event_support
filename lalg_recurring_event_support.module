<?php
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Field\Entity\BaseFieldOverride;
use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Url;
use Drupal\group\Entity\GroupRelationship;
use Drupal\recurring_events\Entity\EventSeries;
use Drupal\recurring_events\Form\EventSeriesCloneForm;

function lalg_recurring_event_support_form_alter(&$form, &$form_state, $form_id) {
    if($form_id != 'eventseries_lalg_event_add_form' && $form_id != 'eventseries_lalg_event_edit_form') {
        return;
    }
    $config = \Drupal::service('config.factory')->getEditable('recurring_events.eventseries.config');
    $form['weekly_recurring_date']['widget'][0]['weekly_interval'] = [
        "#title" => t("Interval"),
        "#type" => "number",
        "#default_value" => $config->get('weekly_interval') ?: 1,
        "#min" => 1,
        "#max" => 4,
        "#step" => 1,
        "#required" => false,
        "#weight" => 0
    ];
    $form['monthly_recurring_date']['widget'][0]['monthly_interval'] = [
        "#title" => t("Interval"),
        "#type" => "number",
        "#default_value" => $config->get('monthly_interval') ?: 1,
        "#min" => 1,
        "#max" => 6,
        "#step" => 1,
        "#required" => false,
        "#weight" => 0
    ];
    $form['actions']['submit']['#submit'][] = 'lalg_recurring_event_support_handler_submit';
    $form['#attached']['library'][] = 'lalg_recurring_event_support/lalg_recurring_event_support.create_form';
}

function lalg_recurring_event_support_handler_submit(&$form, $form_state) {
    $value = $form_state->getValue('weekly_recurring_date')[0]['weekly_interval'];
    \Drupal::service('config.factory')
    ->getEditable('recurring_events.eventseries.config')
    ->set('weekly_interval', $value)
    ->save();
    $value = $form_state->getValue('monthly_recurring_date')[0]['monthly_interval'];
    \Drupal::service('config.factory')
    ->getEditable('recurring_events.eventseries.config')
    ->set('monthly_interval', $value)
    ->save();
}

function lalg_recurring_event_support_form_eventseries_lalg_event_clone_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
    $form['actions']['submit']['#submit'][] = 'lalg_recurring_event_support_attach_cloned_series_to_group';
}

function lalg_recurring_event_support_attach_cloned_series_to_group(&$form, \Drupal\Core\Form\FormStateInterface $form_state) {
    $form_object = $form_state->getFormObject();

    if (!$form_object instanceof EventSeriesCloneForm) {
        return;
    }
    
    // Retrieve the cloned entity from the form object.
    $series = $form_object->getEntity();
    if (!$series || $series->isNew()) {
        return;
    }

    // Retrieve the Group from the route.
    $group = \Drupal::routeMatch()->getParameter('group');
    if (!$group instanceof \Drupal\group\Entity\GroupInterface) {
        if (!is_numeric($group)) {
            return;
        }

        $group = \Drupal::entityTypeManager()
            ->getStorage('group')
            ->load($group);
    }
    if (!$group) {
        return;
    }

    $group->addRelationship(
        $series,
        'group_recurring_events_series:' . $series->bundle()
    );
}

function lalg_recurring_event_support_form_eventinstance_lalg_event_edit_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
    $form['#attached']['library'][] = 'lalg_recurring_event_support/lalg_recurring_event_support.edit_instance_form';
}

function lalg_recurring_event_support_recurring_events_event_instances_pre_create_alter(&$event_instances, EventSeries $event) {
    $monthly_interval = $event->monthly_recurring_date->monthly_interval; // Get Monthly interval
    $weekly_interval = $event->weekly_recurring_date->weekly_interval; // Get Weekly interval
    
    $recur = $event->recur_type->value;

    $weekly = $event->weekly_recurring_date->value; // Get EventSeries start date
    $monthly = $event->monthly_recurring_date->value; // Get start date

    // Return if not monthly or weekly recur type
    if(!(($recur == "monthly_recurring_date" && $monthly_interval > 1) || ($recur == "weekly_recurring_date" && $weekly_interval > 1))) {
        return;
    }
    if($recur == "weekly_recurring_date") {
        $start_date = new DateTime($weekly);

        foreach ($event_instances as $key => $instance) {
            $instance_date = new DateTime($instance['start_date']);
            // Compare start date against each instance date
            $diff = (floor($start_date->diff($instance_date)->days)+1)/7;
            if($diff % $weekly_interval != 0) {
                unset($event_instances[$key]); // unset the instance if it has a date at the wrong interval
            }
        }
    } else if($recur == "monthly_recurring_date") {
        $start_date = new DateTime($monthly);

        foreach($event_instances as $key => $instance) {
            $instance_date = new DateTime($instance['start_date']);
            $instance_date->setTime(0,0);
            $diff = $start_date->diff($instance_date);
            if($diff->m % $monthly_interval != 0) {
                unset($event_instances[$key]); // unset the instance if it has a date at the wrong interval
            }
        }
    }
}

